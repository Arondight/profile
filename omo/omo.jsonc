// OmO configuration: ~/.omo/omo.jsonc
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  // [native]    OmO Native 读取
  "[native]": {
    // 主 agent（会话模型），provider 中只有 glm-5.3 在推荐模型集合内。
    // 只用于新建 Desktop / headless 会话，不覆盖 agents / categories 的独立模型链。
    "model_profiles": {
      "token-plan-cn": {
        "display_name": "Alibaba Token Plan (China)",
        "models": [
          {
            "model": "qwen-token-plan-cn/glm-5.3",
            "reasoning": "max",
          },
        ],
      },
    },
    "model_profile": "token-plan-cn",
    // 只读研究与计划评审 agent
    "agents": {
      "plan-consultant": {
        "model": "qwen-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "plan-reviewer": {
        "model": "qwen-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "explore": {
        "model": "qwen-token-plan-cn/deepseek-v4.1-flash-1017",
        "reasoning": "max",
      },
      "librarian": {
        "model": "qwen-token-plan-cn/deepseek-v4.1-flash-1017",
        "reasoning": "max",
      },
    },
    // 委派 category：S 档统一 glm-5.3，deep-low 走视觉旗舰，B 档走快模型
    "categories": {
      "architect": {
        "model": "qwen-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "visual-engineering": {
        "model": "qwen-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "ultrabrain": {
        "model": "qwen-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "deep-low": {
        "model": "qwen-token-plan-cn/qwen3.8-max",
        "reasoning": "xhigh",
      },
      "deep-high": {
        "model": "qwen-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "artistry": {
        "model": "qwen-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "unspecified-high": {
        "model": "qwen-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "writing": {
        "model": "qwen-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "quick": {
        "model": "qwen-token-plan-cn/deepseek-v4.1-flash-1017",
        "reasoning": "max",
      },
      "unspecified-low": {
        "model": "qwen-token-plan-cn/deepseek-v4.1-flash-1017",
        "reasoning": "max",
      },
    },
  },
  // [opencode]  OpenCode 插件读取
  "[opencode]": {
    // 主编排、规划、评审、检索等 agent
    "agents": {
      "sisyphus": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "hephaestus": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "oracle": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "prometheus": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "metis": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "momus": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "atlas": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "high",
      },
      "sisyphus-junior": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "high",
      },
      "explore": {
        "model": "alibaba-token-plan-cn/deepseek-v4.1-flash-1017",
        "reasoning": "max",
      },
      "librarian": {
        "model": "alibaba-token-plan-cn/deepseek-v4.1-flash-1017",
        "reasoning": "max",
      },
      "multimodal-looker": {
        "model": "alibaba-token-plan-cn/qwen3.8-max",
        "reasoning": "xhigh",
      },
    },
    // 委派 category：S 档统一 glm-5.3，B 档走快模型
    "categories": {
      "visual-engineering": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "ultrabrain": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "deep-low": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "deep-high": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "artistry": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "unspecified-high": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
      "quick": {
        "model": "alibaba-token-plan-cn/deepseek-v4.1-flash-1017",
        "reasoning": "max",
      },
      "unspecified-low": {
        "model": "alibaba-token-plan-cn/deepseek-v4.1-flash-1017",
        "reasoning": "max",
      },
      "writing": {
        "model": "alibaba-token-plan-cn/glm-5.3",
        "reasoning": "max",
      },
    },
  },
}
