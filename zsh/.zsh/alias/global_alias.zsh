for _alias_name in $(alias -g | grep -oP '^.+?(?==)')
do
  unalias "$_alias_name"
done

alias -g ..='..'
alias -g ...='../..'
alias -g ....='../../..'
alias -g .....='../../../..'
alias -g ......='../../../../..'

